{
  "expo": {
    "name": "HomeTik Mitra",
    "slug": "hometik-mitra",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "scheme": "hometik-mitra",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.hometik.mitra",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "HomeTik Mitra membutuhkan lokasi Anda untuk menerima panggilan pelanggan terdekat.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "HomeTik Mitra membutuhkan lokasi latar belakang agar pelanggan dapat melacak kedatangan Anda secara real-time."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      },
      "package": "com.hometik.mitra",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "ACCESS_BACKGROUND_LOCATION",
        "FOREGROUND_SERVICE",
        "FOREGROUND_SERVICE_LOCATION"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Izinkan HomeTik Mitra melacak lokasi agar pelanggan dapat melihat posisi kedatangan Anda.",
          "isAndroidBackgroundLocationEnabled": true,
          "isAndroidForegroundServiceEnabled": true
        }
      ],
      "expo-splash-screen",
      "expo-status-bar"
    ]
  }
}
