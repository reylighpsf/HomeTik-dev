{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true,
    "composite": true
  },
  "references": [
    {
      "path": "packages/shared-types"
    },
    {
      "path": "apps/backend"
    },
    {
      "path": "apps/mobile"
    }
  ],
  "extends": "expo/tsconfig.base"
}
