{
  "name": "hometik-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "start": "npm --prefix apps/mobile run start",
    "dev:mobile": "npm --prefix apps/mobile run start",
    "dev:mitra": "npm --prefix apps/mitra run start",
    "mitra:android": "npm --prefix apps/mitra run android",
    "mitra:web": "npm --prefix apps/mitra run web",
    "android": "npm --prefix apps/mobile run android",
    "ios": "npm --prefix apps/mobile run ios",
    "web": "npm --prefix apps/mobile run web",
    "dev:backend": "npm --prefix apps/backend run dev",
    "dev:web": "npm --prefix apps/backend run dev",
    "build:backend": "npm --prefix apps/backend run build",
    "build:web": "npm --prefix apps/backend run build",
    "lint": "npm run lint --workspaces",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "npm@10.0.0",
  "devDependencies": {
    "ajv": "^8.20.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
